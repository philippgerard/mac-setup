#!/bin/bash -p

set -euo pipefail
umask 077

REPO_ROOT="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=scripts/trusted-path
source "$REPO_ROOT/scripts/trusted-path"
mac_setup_harden_environment
# shellcheck source=scripts/private-state-paths
source "$REPO_ROOT/scripts/private-state-paths"
# shellcheck source=scripts/trusted-1password
source "$REPO_ROOT/scripts/trusted-1password"

CONFIG_FILE="${MAC_SETUP_MAIL_CONFIG_FILE:-$MAC_SETUP_MAIL_CONFIG_FILE_DEFAULT}"
CONFIG_FILE="$(mac_setup_canonical_private_path \
  "$REPO_ROOT" "$CONFIG_FILE" "Mail account config")"
ONEPASSWORD_ACCOUNT_VALUE="${MAC_SETUP_1PASSWORD_ACCOUNT:-}"
VAULT="${MAC_SETUP_1PASSWORD_VAULT:-$MAC_SETUP_1PASSWORD_VAULT_DEFAULT}"
NATIVE_HELPER_SOURCE="$REPO_ROOT/scripts/native/smime-keychain-helper.m"
ACCOUNT_ID=""

mac_setup_sanitize_1password_environment
if [[ -n "$ONEPASSWORD_ACCOUNT_VALUE" ]]; then
  [[ "$ONEPASSWORD_ACCOUNT_VALUE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "unsafe 1Password account ID or shorthand" >&2
    exit 1
  }
  export OP_ACCOUNT="$ONEPASSWORD_ACCOUNT_VALUE"
fi
[[ "$VAULT" != *$'\n'* && "$VAULT" != *$'\r'* ]] || {
  echo "unsafe 1Password vault name" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: restore-smime-identities-from-1password --account-id <id>

Find every tagged S/MIME Login item for the selected private Mail account,
check its PKCS#12 identity against the login keychain, and securely import only
missing identities. PKCS#12 passwords flow from 1Password to a native helper
through an anonymous pipe and are never passed as command arguments.

Options:
  --account-id <id>  Private Mail account ID to restore.
  -h, --help         Show this help.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --account-id)
      [[ $# -ge 2 ]] || { echo "missing value for --account-id" >&2; exit 2; }
      ACCOUNT_ID="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

[[ "$ACCOUNT_ID" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || {
  echo "unsafe or missing Mail account ID" >&2
  exit 2
}

for command_name in jq mktemp op; do
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "required command not found: $command_name" >&2
    exit 1
  }
done
[[ -x /usr/bin/xcrun ]] || {
  echo "required command not found: /usr/bin/xcrun" >&2
  exit 1
}
[[ -f "$NATIVE_HELPER_SOURCE" && ! -L "$NATIVE_HELPER_SOURCE" ]] || {
  echo "native S/MIME helper source is missing or unsafe" >&2
  exit 1
}

op account get --format json >/dev/null 2>&1 || {
  echo "sign in to 1Password CLI before restoring S/MIME identities" >&2
  exit 1
}
"$REPO_ROOT/scripts/validate-mail-accounts-config" "$CONFIG_FILE" >/dev/null

account_smime="$(
  jq -er --arg id "$ACCOUNT_ID" '
    [.accounts[] | select(.id == $id)] as $matches
    | if ($matches | length) == 1 then
        ($matches[0].smime // false)
      else
        error("selected Mail account ID is not present exactly once")
      end
  ' "$CONFIG_FILE"
)"
if [[ "$account_smime" != "true" ]]; then
  echo "S/MIME is not declared for Mail account '$ACCOUNT_ID'; nothing to restore."
  exit 0
fi

temp_dir="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/mac-setup-smime.XXXXXX")"
cleanup() {
  if [[ -n "${temp_dir:-}" && -d "$temp_dir" && ! -L "$temp_dir" && \
    -O "$temp_dir" && "$temp_dir" == "${TMPDIR:-/tmp}"/mac-setup-smime.* ]]; then
    /bin/rm -rf -- "$temp_dir" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT
/bin/chmod 700 "$temp_dir"

helper_binary="$temp_dir/smime-keychain-helper"
module_cache="$temp_dir/clang-modules"
/bin/mkdir -m 700 "$module_cache"
/usr/bin/xcrun clang \
  -fobjc-arc \
  -fmodules-cache-path="$module_cache" \
  -Werror \
  -Wno-deprecated-declarations \
  "$NATIVE_HELPER_SOURCE" \
  -framework Foundation \
  -framework Security \
  -o "$helper_binary"
[[ -x "$helper_binary" && ! -L "$helper_binary" ]] || {
  echo "native S/MIME helper did not compile safely" >&2
  exit 1
}

title_prefix="Mac Setup S-MIME $ACCOUNT_ID "
if [[ -n "$VAULT" ]]; then
  item_list_json="$(
    op item list --categories Login --tags smime --vault "$VAULT" --format json
  )" || {
    echo "could not list S/MIME Login items in the selected 1Password vault" >&2
    exit 1
  }
else
  item_list_json="$(
    op item list --categories Login --tags smime --format json
  )" || {
    echo "could not list S/MIME Login items in the selected 1Password account" >&2
    exit 1
  }
fi

item_ids="$(
  jq -er --arg prefix "$title_prefix" '
    if type != "array" then
      error("item list is not an array")
    else
      [
        .[]
        | select(
            (.id | type == "string")
            and (.title | type == "string")
            and (.title | startswith($prefix))
          )
      ]
      | sort_by(.title)
      | if length > 0 then .[].id else error("no matching items") end
    end
  ' <<<"$item_list_json"
)" || {
  echo "no unambiguous S/MIME Login items were found for '$ACCOUNT_ID'" >&2
  exit 1
}

periods_file="$temp_dir/periods"
: >"$periods_file"
/bin/chmod 600 "$periods_file"
metadata_file="$temp_dir/metadata"
: >"$metadata_file"
/bin/chmod 600 "$metadata_file"
current_count=0

while IFS= read -r item_id; do
  [[ "$item_id" =~ ^[a-z0-9]{20,64}$ ]] || {
    echo "1Password returned an unsafe S/MIME item ID" >&2
    exit 1
  }

  if [[ -n "$VAULT" ]]; then
    item_json="$(
      op item get "$item_id" --vault "$VAULT" --format json |
        jq -e 'del(.fields[]? | select((.type // "") == "CONCEALED") | .value)'
    )" || {
      echo "could not safely read an S/MIME Login item" >&2
      exit 1
    }
  else
    item_json="$(
      op item get "$item_id" --format json |
        jq -e 'del(.fields[]? | select((.type // "") == "CONCEALED") | .value)'
    )" || {
      echo "could not safely read an S/MIME Login item" >&2
      exit 1
    }
  fi

  metadata="$(
    "$REPO_ROOT/scripts/validate-smime-1password-item" \
      --account-id "$ACCOUNT_ID" <<<"$item_json"
  )" || {
    echo "an S/MIME Login item does not match the required safe structure" >&2
    exit 1
  }

  IFS=$'\t' read -r vault_id resolved_item_id password_field_id \
    file_id certificate_period certificate_status <<<"$metadata"
  [[ "$resolved_item_id" == "$item_id" ]] || {
    echo "1Password returned inconsistent S/MIME item metadata" >&2
    exit 1
  }
  if /usr/bin/grep -Fqx -- "$certificate_period" "$periods_file"; then
    echo "duplicate S/MIME certificate period for '$ACCOUNT_ID'" >&2
    exit 1
  fi
  printf '%s\n' "$certificate_period" >>"$periods_file"
  if [[ "$certificate_status" == "current" ]]; then
    current_count=$((current_count + 1))
  fi
  printf '%s\n' "$metadata" >>"$metadata_file"
done <<<"$item_ids"

[[ "$current_count" -eq 1 ]] || {
  echo "S/MIME recovery requires exactly one item marked current for '$ACCOUNT_ID'" >&2
  exit 1
}

restored_count=0
present_count=0
while IFS=$'\t' read -r vault_id resolved_item_id password_field_id \
  file_id certificate_period certificate_status; do
  identity_file="$temp_dir/identity.p12"
  /bin/rm -f -- "$identity_file"
  file_reference="op://$vault_id/$resolved_item_id/$file_id"
  password_reference="op://$vault_id/$resolved_item_id/$password_field_id"
  op read --force --out-file "$identity_file" --file-mode 0600 \
    "$file_reference" >/dev/null || {
      echo "could not download an S/MIME PKCS#12 attachment" >&2
      exit 1
    }
  [[ -f "$identity_file" && ! -L "$identity_file" && -O "$identity_file" && \
    "$(/usr/bin/stat -f '%Lp' "$identity_file")" == "600" && \
    -s "$identity_file" ]] || {
    echo "downloaded S/MIME PKCS#12 attachment is unsafe or empty" >&2
    exit 1
  }

  restore_result="$(
    op read --force --no-newline "$password_reference" |
      "$helper_binary" restore --pkcs12 "$identity_file"
  )" || {
    echo "S/MIME identity restore failed for period '$certificate_period'" >&2
    exit 1
  }
  /bin/rm -f -- "$identity_file"

  case "$restore_result" in
    present)
      present_count=$((present_count + 1))
      echo "S/MIME identity '$certificate_period' is already present in the login keychain."
      ;;
    imported)
      restored_count=$((restored_count + 1))
      echo "S/MIME identity '$certificate_period' was imported into the login keychain."
      ;;
    *)
      echo "native S/MIME helper returned an unexpected result" >&2
      exit 1
      ;;
  esac
done <"$metadata_file"

echo "S/MIME identity restore complete for '$ACCOUNT_ID': $present_count present, $restored_count imported."
echo "Mail must still be tested with current and retained historical encrypted messages."
