#!/bin/bash -p

set -euo pipefail
umask 077

SCRIPT_DIR="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(/usr/bin/dirname "$SCRIPT_DIR")"
# shellcheck source=scripts/trusted-path
source "$SCRIPT_DIR/trusted-path"
mac_setup_harden_environment
# shellcheck source=scripts/private-state-paths
source "$SCRIPT_DIR/private-state-paths"
# shellcheck source=scripts/trusted-1password
source "$SCRIPT_DIR/trusted-1password"
GNUPGHOME="$(mac_setup_canonical_private_path \
  "$REPO_ROOT" "$HOME/.gnupg" "GnuPG home directory")"
export GNUPGHOME

SECRET_DOCUMENT="${1:-${MAC_SETUP_GPG_SECRET_DOCUMENT:-Mac Setup GPG Secret Keys}}"
OWNERTRUST_DOCUMENT="${2:-${MAC_SETUP_GPG_OWNERTRUST_DOCUMENT:-Mac Setup GPG Ownertrust}}"
VAULT="${MAC_SETUP_1PASSWORD_VAULT:-$MAC_SETUP_1PASSWORD_VAULT_DEFAULT}"
ONEPASSWORD_ACCOUNT_VALUE="${MAC_SETUP_1PASSWORD_ACCOUNT:-}"

mac_setup_sanitize_1password_environment
if [[ -n "$ONEPASSWORD_ACCOUNT_VALUE" ]]; then
  [[ "$ONEPASSWORD_ACCOUNT_VALUE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "unsafe 1Password account ID or shorthand" >&2
    exit 1
  }
  export OP_ACCOUNT="$ONEPASSWORD_ACCOUNT_VALUE"
fi
[[ "$VAULT" != *$'\n'* && "$VAULT" != *$'\r'* ]] || {
  echo "unsafe 1Password vault name" >&2
  exit 1
}

find_gpg() {
  if command -v gpg >/dev/null 2>&1; then
    command -v gpg
    return
  fi
  return 1
}

GPG_BIN="$(find_gpg)" || {
  echo "required command not found: gpg" >&2
  exit 1
}
if [[ -e "$GNUPGHOME" || -L "$GNUPGHOME" ]]; then
  [[ -d "$GNUPGHOME" && ! -L "$GNUPGHOME" && -O "$GNUPGHOME" ]] || {
    echo "GnuPG home directory is unsafe" >&2
    exit 1
  }
  /bin/chmod 700 "$GNUPGHOME"
else
  /usr/bin/install -d -m 700 "$GNUPGHOME"
fi

command -v op >/dev/null 2>&1 || {
  echo "required command not found: op" >&2
  exit 1
}

op account get --format json >/dev/null 2>&1 || {
  echo "sign in to 1Password CLI before restoring keys" >&2
  exit 1
}

if [[ -n "$VAULT" ]]; then
  op document get "$SECRET_DOCUMENT" --vault "$VAULT" | "$GPG_BIN" --batch --import
  op document get "$OWNERTRUST_DOCUMENT" --vault "$VAULT" | "$GPG_BIN" --batch --import-ownertrust
else
  op document get "$SECRET_DOCUMENT" | "$GPG_BIN" --batch --import
  op document get "$OWNERTRUST_DOCUMENT" | "$GPG_BIN" --batch --import-ownertrust
fi

echo "GPG secret key and ownertrust import completed. Verify the fingerprint before use."
