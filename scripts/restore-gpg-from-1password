#!/bin/bash

set -euo pipefail

SECRET_DOCUMENT="${1:-${MAC_SETUP_GPG_SECRET_DOCUMENT:-Mac Setup GPG Secret Keys}}"
OWNERTRUST_DOCUMENT="${2:-${MAC_SETUP_GPG_OWNERTRUST_DOCUMENT:-Mac Setup GPG Ownertrust}}"
VAULT="${MAC_SETUP_1PASSWORD_VAULT:-}"

for command_name in gpg op; do
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "required command not found: $command_name" >&2
    exit 1
  }
done

op account get --format json >/dev/null 2>&1 || {
  echo "sign in to 1Password CLI before restoring keys" >&2
  exit 1
}

if [[ -n "$VAULT" ]]; then
  op document get "$SECRET_DOCUMENT" --vault "$VAULT" | gpg --batch --import
  op document get "$OWNERTRUST_DOCUMENT" --vault "$VAULT" | gpg --batch --import-ownertrust
else
  op document get "$SECRET_DOCUMENT" | gpg --batch --import
  op document get "$OWNERTRUST_DOCUMENT" | gpg --batch --import-ownertrust
fi

echo "GPG secret key and ownertrust import completed. Verify the fingerprint before use."
