#!/bin/bash

MAC_SETUP_PUBLIC_REPOSITORY_URL="https://github.com/philippgerard/mac-setup"

mac_setup_public_identity_name() {
  local public_name

  public_name="${MAC_SETUP_PUBLIC_REPOSITORY_URL#https://github.com/}"
  public_name="${public_name%%/*}"
  [[ "$public_name" =~ ^[A-Za-z0-9._-]+$ ]] || {
    echo "public repository owner is invalid" >&2
    return 1
  }
  printf '%s\n' "$public_name"
}

mac_setup_validate_git_identity_fields() {
  [[ $# -eq 6 ]] || {
    echo "Git identity validation requires six fields" >&2
    return 2
  }

  local git_name="$1"
  local git_email="$2"
  local git_signing_key="$3"
  local public_name="$4"
  local public_email="$5"
  local public_signing_key="$6"
  local field_label
  local field_value
  local expected_public_name
  local canonical_public_email
  local public_email_prefix
  local public_email_pattern

  for field_label in \
    git_name git_email git_signing_key \
    public_name public_email public_signing_key; do
    case "$field_label" in
      git_name) field_value="$git_name" ;;
      git_email) field_value="$git_email" ;;
      git_signing_key) field_value="$git_signing_key" ;;
      public_name) field_value="$public_name" ;;
      public_email) field_value="$public_email" ;;
      public_signing_key) field_value="$public_signing_key" ;;
    esac
    [[ -n "$field_value" && "$field_value" != *[[:cntrl:]]* ]] || {
      echo "$field_label must be nonempty and contain no control characters" >&2
      return 1
    }
  done

  [[ "$git_email" =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]] || {
    echo "email must be a single whitespace-free address" >&2
    return 1
  }
  [[ "$git_signing_key" =~ ^(ssh-(rsa|ed25519)|ecdsa-[^[:space:]]+)[[:blank:]][A-Za-z0-9+/=]+([[:blank:]][^[:cntrl:]]*)?$ ]] || {
    echo "signing_key must contain one complete SSH public key" >&2
    return 1
  }

  expected_public_name="$(mac_setup_public_identity_name)"
  [[ "$public_name" == "$expected_public_name" ]] || {
    echo "public_name must exactly match the public repository owner" >&2
    return 1
  }
  canonical_public_email="$expected_public_name$(printf '@')users.noreply.github.com"
  public_email_pattern='^[0-9]+$'
  public_email_prefix="${public_email%%+*}"
  if [[ "$public_email" != "$canonical_public_email" ]]; then
    [[ "$public_email_prefix" =~ $public_email_pattern && \
      "${public_email#*+}" == "$canonical_public_email" ]] || {
      echo "public_email must be the repository owner's GitHub noreply address" >&2
      return 1
    }
  fi
  [[ "$public_signing_key" =~ ^(ssh-(rsa|ed25519)|ecdsa-[^[:space:]]+)[[:blank:]][A-Za-z0-9+/=]+([[:blank:]][^[:cntrl:]]*)?$ ]] || {
    echo "public_signing_key must contain one complete SSH public key" >&2
    return 1
  }
}
