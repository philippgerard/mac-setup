#!/bin/bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HELPER="$REPO_ROOT/scripts/trusted-1password"

# shellcheck source=scripts/trusted-1password
source "$HELPER"

export OP_ACCOUNT="ambient-account"
export OP_CONFIG_DIR="/tmp/ambient-op-config"
export OP_CONNECT_HOST="https://connect.invalid"
export OP_CONNECT_TOKEN="ambient-connect-token"
export OP_FORMAT="json"
export OP_SERVICE_ACCOUNT_TOKEN="ambient-service-token"
export OP_SESSION_example="ambient-session"
export OP_VAULT="ambient-vault"
MAC_SETUP_1PASSWORD_ACCOUNT="explicit-account"
MAC_SETUP_1PASSWORD_VAULT="Explicit Vault"

mac_setup_sanitize_1password_environment

for variable_name in \
  OP_ACCOUNT OP_CONFIG_DIR OP_CONNECT_HOST OP_CONNECT_TOKEN OP_FORMAT \
  OP_SERVICE_ACCOUNT_TOKEN OP_SESSION_example OP_VAULT; do
  if declare -p "$variable_name" >/dev/null 2>&1; then
    echo "1Password environment sanitizer retained $variable_name" >&2
    exit 1
  fi
done

[[ "$MAC_SETUP_1PASSWORD_ACCOUNT" == "explicit-account" ]]
[[ "$MAC_SETUP_1PASSWORD_VAULT" == "Explicit Vault" ]]

protected_helpers=(
  backup-filen-menubar-to-1password
  backup-gpg-to-1password
  backup-mail-accounts-to-1password
  configure-git-identity
  finish-setup
  restore-filen-menubar-from-1password
  restore-gpg-from-1password
  restore-mail-accounts-from-1password
)
for helper_name in "${protected_helpers[@]}"; do
  helper_path="$REPO_ROOT/scripts/$helper_name"
  /usr/bin/grep -Fq "source \"\$SCRIPT_DIR/trusted-1password\"" "$helper_path" || \
    /usr/bin/grep -Fq "source \"\$REPO_ROOT/scripts/trusted-1password\"" "$helper_path" || {
      echo "$helper_name does not source the 1Password environment guard" >&2
      exit 1
    }
  /usr/bin/grep -Fq 'mac_setup_sanitize_1password_environment' "$helper_path" || {
    echo "$helper_name does not sanitize the 1Password environment" >&2
    exit 1
  }
done

echo "1Password environment isolation tests passed"
