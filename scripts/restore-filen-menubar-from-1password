#!/bin/bash

set -euo pipefail

PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH

DOCUMENT="${1:-${MAC_SETUP_FILEN_CONFIG_DOCUMENT:-Mac Setup Filen Menubar Config}}"
VAULT="${MAC_SETUP_1PASSWORD_VAULT:-}"
CONFIG_FILE="${FILEN_MENUBAR_CONFIG_FILE:-$HOME/Library/Application Support/filen-menubar/config.json}"
CONFIG_DIR="$(dirname "$CONFIG_FILE")"

for command_name in op jq mktemp; do
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "required command not found: $command_name" >&2
    exit 1
  }
done

op account get --format json >/dev/null 2>&1 || {
  echo "sign in to 1Password CLI before restoring the Filen Menubar config" >&2
  exit 1
}

install -d -m 700 "$CONFIG_DIR"
umask 077
config_tmp="$(mktemp "$CONFIG_DIR/.config.XXXXXX")"
trap 'rm -f "$config_tmp"' EXIT

if [[ -n "$VAULT" ]]; then
  op document get "$DOCUMENT" --vault "$VAULT" >"$config_tmp"
else
  op document get "$DOCUMENT" >"$config_tmp"
fi

jq -e '
  type == "object"
  and (.localPath | type == "string" and length > 0)
  and (.remotePath | type == "string" and length > 0)
  and (.syncMode | IN("twoWay", "localToCloud", "cloudToLocal", "localBackup", "cloudBackup"))
  and (.autoStart | type == "boolean")
  and ((has("ignore") | not) or (.ignore | type == "array" and all(.[]; type == "string")))
  and ((has("excludeDotFiles") | not) or (.excludeDotFiles | type == "boolean"))
  and ((has("locale") | not) or (.locale | type == "string"))
  and ((has("loggingEnabled") | not) or (.loggingEnabled | type == "boolean"))
  and ((has("logLevel") | not) or (.logLevel | IN("trace", "debug", "info", "warn", "error")))
' "$config_tmp" >/dev/null || {
  echo "the 1Password document is not a valid Filen Menubar config" >&2
  exit 1
}

chmod 600 "$config_tmp"

config_backup=""
if [[ -f "$CONFIG_FILE" ]] && ! cmp -s "$CONFIG_FILE" "$config_tmp"; then
  config_backup="${CONFIG_FILE}.pre-restore-$(date -u '+%Y%m%dT%H%M%SZ')"
  install -m 600 "$CONFIG_FILE" "$config_backup"
fi

mv "$config_tmp" "$CONFIG_FILE"
trap - EXIT

echo "Filen Menubar config was restored with mode 0600."
if [[ -n "$config_backup" ]]; then
  echo "The different previous config was preserved beside it with a pre-restore timestamp."
fi
echo "Quit and reopen Filen Menubar if it was already running."
