#!/bin/bash -p

set -euo pipefail

REPO_ROOT="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SSH_MODULE="$REPO_ROOT/modules/home/ssh.nix"

for expected_line in \
  'item = "Mac Setup Git Signing"' \
  'vault = "Mac Setup"' \
  'vault = "Personal"' \
  'vault = "Private"' \
  'vault = "Employee"'; do
  [[ "$(/usr/bin/grep -Fxc -- "    $expected_line" "$SSH_MODULE")" -eq 1 ]] || {
    echo "1Password SSH agent config is missing a required generic selector" >&2
    exit 1
  }
done

if /usr/bin/grep -Eq \
  '^[[:space:]]*(account|item|vault)[[:space:]]*=[[:space:]]*"[a-z0-9]{20,64}"' \
  "$SSH_MODULE"; then
  echo "1Password SSH agent config contains a private object ID" >&2
  exit 1
fi

mac_setup_line="$(
  /usr/bin/grep -nF 'vault = "Mac Setup"' "$SSH_MODULE" |
    /usr/bin/cut -d: -f1
)"
personal_line="$(
  /usr/bin/grep -nF 'vault = "Personal"' "$SSH_MODULE" |
    /usr/bin/cut -d: -f1
)"
[[ "$mac_setup_line" -lt "$personal_line" ]] || {
  echo "the Mac Setup signing key must be offered before default-vault keys" >&2
  exit 1
}

echo "1Password SSH agent configuration tests passed"
