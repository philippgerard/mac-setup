#!/bin/bash -p

set -euo pipefail

REPO_ROOT="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=scripts/trusted-path
source "$REPO_ROOT/scripts/trusted-path"
mac_setup_harden_environment

ACCOUNT_ID=""
usage() {
  cat <<'EOF'
Usage: validate-smime-1password-item --account-id <id>

Validate one sanitized 1Password Login item read from standard input. Concealed
field values must already be removed. Print only safe object IDs and the
certificate period/status required by the restore helper.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --account-id)
      [[ $# -ge 2 ]] || { echo "missing value for --account-id" >&2; exit 2; }
      ACCOUNT_ID="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

[[ "$ACCOUNT_ID" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || {
  echo "unsafe or missing Mail account ID" >&2
  exit 2
}
command -v jq >/dev/null 2>&1 || {
  echo "required command not found: jq" >&2
  exit 1
}

title_prefix="Mac Setup S-MIME $ACCOUNT_ID "
jq -er \
  --arg account_id "$ACCOUNT_ID" \
  --arg title_prefix "$title_prefix" '
  def exactly_one($values):
    ($values | length) == 1;
  def safe_object_id:
    type == "string" and test("^[a-z0-9]{20,64}$");
  def safe_period:
    type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$");
  def supported_status:
    . == "current" or . == "historical" or . == "revoked";
  def test_state:
    . == "pending" or
    (type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"));

  [.fields[]? | select(.id == "username")] as $usernames
  | [.fields[]? | select(.id == "password" and .type == "CONCEALED")] as $passwords
  | [.fields[]? | select(.label == "certificate period")] as $periods
  | [.fields[]? | select(.label == "certificate status")] as $statuses
  | [.fields[]? | select(.label == "last successful decryption test")] as $tests
  | if
      (.id | safe_object_id)
      and (.vault.id | safe_object_id)
      and exactly_one($usernames)
      and ($usernames[0].value == $account_id)
      and exactly_one($passwords)
      and ($passwords[0].id == "password")
      and (($passwords[0] | has("value")) | not)
      and exactly_one($periods)
      and ($periods[0].value | safe_period)
      and exactly_one($statuses)
      and ($statuses[0].value | supported_status)
      and exactly_one($tests)
      and ($tests[0].value | test_state)
      and (.title == ($title_prefix + $periods[0].value))
      and ((.tags // []) | index("mac-setup") != null)
      and ((.tags // []) | index("smime") != null)
      and ((.files // []) | length == 1)
      and (.files[0].id | safe_object_id)
      and (.files[0].name | type == "string")
      and (.files[0].name | test("\\.(p12|pfx)$"; "i"))
    then
      [
        .vault.id,
        .id,
        $passwords[0].id,
        .files[0].id,
        $periods[0].value,
        $statuses[0].value
      ] | @tsv
    else
      error("S/MIME item does not match the required structure")
    end
  '
