#!/bin/bash -p

set -euo pipefail
umask 077

SCRIPT_DIR="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(/usr/bin/dirname "$SCRIPT_DIR")"
# shellcheck source=scripts/trusted-path
source "$SCRIPT_DIR/trusted-path"
mac_setup_harden_environment
# shellcheck source=scripts/private-state-paths
source "$SCRIPT_DIR/private-state-paths"
# shellcheck source=scripts/trusted-1password
source "$SCRIPT_DIR/trusted-1password"
VERIFY_STREAM="$SCRIPT_DIR/verify-stream-sha256"
GNUPGHOME="$(mac_setup_canonical_private_path \
  "$REPO_ROOT" "$HOME/.gnupg" "GnuPG home directory")"
export GNUPGHOME

if [[ -t 0 ]]; then
  GPG_TTY="$(tty)"
  export GPG_TTY
fi

VAULT="${MAC_SETUP_1PASSWORD_VAULT:-}"
ONEPASSWORD_ACCOUNT_VALUE="${MAC_SETUP_1PASSWORD_ACCOUNT:-}"
SECRET_TITLE="Mac Setup GPG Secret Keys"
OWNERTRUST_TITLE="Mac Setup GPG Ownertrust"

mac_setup_sanitize_1password_environment
if [[ -n "$ONEPASSWORD_ACCOUNT_VALUE" ]]; then
  [[ "$ONEPASSWORD_ACCOUNT_VALUE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "unsafe 1Password account ID or shorthand" >&2
    exit 1
  }
  export OP_ACCOUNT="$ONEPASSWORD_ACCOUNT_VALUE"
fi
[[ "$VAULT" != *$'\n'* && "$VAULT" != *$'\r'* ]] || {
  echo "unsafe 1Password vault name" >&2
  exit 1
}

find_gpg() {
  if command -v gpg >/dev/null 2>&1; then
    command -v gpg
    return
  fi
  return 1
}

GPG_BIN="$(find_gpg)" || {
  echo "required command not found: gpg" >&2
  exit 1
}
if [[ -e "$GNUPGHOME" || -L "$GNUPGHOME" ]]; then
  [[ -d "$GNUPGHOME" && ! -L "$GNUPGHOME" && -O "$GNUPGHOME" ]] || {
    echo "GnuPG home directory is unsafe" >&2
    exit 1
  }
  /bin/chmod 700 "$GNUPGHOME"
else
  /usr/bin/install -d -m 700 "$GNUPGHOME"
fi

for command_name in op jq; do
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "required command not found: $command_name" >&2
    exit 1
  }
done
[[ -x "$VERIFY_STREAM" && -f "$VERIFY_STREAM" && ! -L "$VERIFY_STREAM" ]] || {
  echo "required attachment verifier is unavailable or unsafe" >&2
  exit 1
}

op account get --format json >/dev/null 2>&1 || {
  echo "sign in to 1Password CLI before backing up keys" >&2
  exit 1
}

fingerprints=()
if [[ $# -gt 0 ]]; then
  for candidate in "$@"; do
    normalized="$(printf '%s' "$candidate" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')"
    [[ "$normalized" =~ ^[0-9A-F]{40}$ ]] || {
      echo "expected full 40-character OpenPGP fingerprints" >&2
      exit 2
    }
    fingerprints+=("$normalized")
  done
else
  fingerprint_output="$({
    "$GPG_BIN" --batch --with-colons --list-secret-keys 2>/dev/null |
      awk -F: '$1 == "sec" { want_fpr = 1; next } want_fpr && $1 == "fpr" { print toupper($10); want_fpr = 0 }'
  })" || {
    echo "GPG could not list secret keys; repair the local gpg-agent configuration first" >&2
    exit 1
  }

  while IFS= read -r fingerprint; do
    [[ -n "$fingerprint" ]] || continue
    fingerprints+=("$fingerprint")
  done <<<"$fingerprint_output"
fi

[[ ${#fingerprints[@]} -gt 0 ]] || {
  echo "no local OpenPGP secret keys were found" >&2
  exit 1
}

for fingerprint in "${fingerprints[@]}"; do
  "$GPG_BIN" --batch --list-secret-keys "$fingerprint" >/dev/null 2>&1 || {
    echo "a requested secret key is not available locally" >&2
    exit 1
  }
done

upsert_document() {
  local title="$1"
  local file_name="$2"
  local existing_id

  if ! existing_id="$(
    mac_setup_find_unique_document_id "$title" "$VAULT"
  )"; then
    echo "could not safely resolve the existing GPG backup" >&2
    return 1
  fi

  if [[ -n "$existing_id" ]]; then
    if [[ -n "$VAULT" ]]; then
      op document edit "$existing_id" - --vault "$VAULT" \
        --file-name "$file_name" --tags "mac-setup,gpg-backup" >/dev/null
    else
      op document edit "$existing_id" - \
        --file-name "$file_name" --tags "mac-setup,gpg-backup" >/dev/null
    fi
    printf '%s\n' "$existing_id"
  else
    if [[ -n "$VAULT" ]]; then
      op document create - --vault "$VAULT" --title "$title" \
        --file-name "$file_name" --tags "mac-setup,gpg-backup" | jq -er '.id'
    else
      op document create - --title "$title" \
        --file-name "$file_name" --tags "mac-setup,gpg-backup" | jq -er '.id'
    fi
  fi
}

secret_export="$("$GPG_BIN" --batch --export-secret-keys --armor "${fingerprints[@]}" 2>/dev/null)" || {
  echo "GPG secret-key export was cancelled or failed" >&2
  exit 1
}
[[ -n "$secret_export" ]] || {
  echo "GPG did not produce a secret-key export" >&2
  exit 1
}
secret_export_hash="$(printf '%s\n' "$secret_export" |
  /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"

secret_item_id="$(printf '%s\n' "$secret_export" |
  upsert_document "$SECRET_TITLE" "gpg-secret-keys.asc")"
unset secret_export
[[ -n "$secret_item_id" ]] || {
  echo "the 1Password secret-key document was not created" >&2
  exit 1
}

ownertrust_export="$("$GPG_BIN" --batch --export-ownertrust 2>/dev/null)" || {
  echo "GPG ownertrust export failed" >&2
  exit 1
}
ownertrust_export_hash="$(printf '%s\n' "$ownertrust_export" |
  /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"
ownertrust_item_id="$(printf '%s\n' "$ownertrust_export" |
  upsert_document "$OWNERTRUST_TITLE" "gpg-ownertrust.txt")"
unset ownertrust_export
[[ -n "$ownertrust_item_id" ]] || {
  echo "the 1Password ownertrust document was not created" >&2
  exit 1
}

if [[ -n "$VAULT" ]]; then
  op document get "$secret_item_id" --vault "$VAULT" |
    "$VERIFY_STREAM" "$secret_export_hash" "GPG secret-key document"
  op document get "$ownertrust_item_id" --vault "$VAULT" |
    "$VERIFY_STREAM" "$ownertrust_export_hash" "GPG ownertrust document"
else
  op document get "$secret_item_id" |
    "$VERIFY_STREAM" "$secret_export_hash" "GPG secret-key document"
  op document get "$ownertrust_item_id" |
    "$VERIFY_STREAM" "$ownertrust_export_hash" "GPG ownertrust document"
fi

echo "GPG secret keys and ownertrust were backed up and verified in 1Password."
