#!/bin/bash

set -euo pipefail

if [[ -t 0 ]]; then
  GPG_TTY="$(tty)"
  export GPG_TTY
fi

VAULT="${MAC_SETUP_1PASSWORD_VAULT:-}"
SECRET_TITLE="Mac Setup GPG Secret Keys"
OWNERTRUST_TITLE="Mac Setup GPG Ownertrust"

for command_name in gpg op jq; do
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "required command not found: $command_name" >&2
    exit 1
  }
done

op account get --format json >/dev/null 2>&1 || {
  echo "sign in to 1Password CLI before backing up keys" >&2
  exit 1
}

fingerprints=()
if [[ $# -gt 0 ]]; then
  for candidate in "$@"; do
    normalized="$(printf '%s' "$candidate" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')"
    [[ "$normalized" =~ ^[0-9A-F]{40}$ ]] || {
      echo "expected full 40-character OpenPGP fingerprints" >&2
      exit 2
    }
    fingerprints+=("$normalized")
  done
else
  fingerprint_output="$({
    gpg --batch --with-colons --list-secret-keys 2>/dev/null |
      awk -F: '$1 == "sec" { want_fpr = 1; next } want_fpr && $1 == "fpr" { print toupper($10); want_fpr = 0 }'
  })" || {
    echo "GPG could not list secret keys; repair the local gpg-agent configuration first" >&2
    exit 1
  }

  while IFS= read -r fingerprint; do
    [[ -n "$fingerprint" ]] || continue
    fingerprints+=("$fingerprint")
  done <<<"$fingerprint_output"
fi

[[ ${#fingerprints[@]} -gt 0 ]] || {
  echo "no local OpenPGP secret keys were found" >&2
  exit 1
}

for fingerprint in "${fingerprints[@]}"; do
  gpg --batch --list-secret-keys "$fingerprint" >/dev/null 2>&1 || {
    echo "a requested secret key is not available locally" >&2
    exit 1
  }
done

upsert_document() {
  local title="$1"
  local file_name="$2"
  local existing_id

  if [[ -n "$VAULT" ]]; then
    existing_id="$(op item get "$title" --vault "$VAULT" --format json 2>/dev/null | jq -r '.id // empty' || true)"
  else
    existing_id="$(op item get "$title" --format json 2>/dev/null | jq -r '.id // empty' || true)"
  fi

  if [[ -n "$existing_id" ]]; then
    if [[ -n "$VAULT" ]]; then
      op document edit "$existing_id" - --vault "$VAULT" \
        --file-name "$file_name" --tags "mac-setup,gpg-backup" >/dev/null
    else
      op document edit "$existing_id" - \
        --file-name "$file_name" --tags "mac-setup,gpg-backup" >/dev/null
    fi
    printf '%s\n' "$existing_id"
  else
    if [[ -n "$VAULT" ]]; then
      op document create - --vault "$VAULT" --title "$title" \
        --file-name "$file_name" --tags "mac-setup,gpg-backup" | jq -er '.id'
    else
      op document create - --title "$title" \
        --file-name "$file_name" --tags "mac-setup,gpg-backup" | jq -er '.id'
    fi
  fi
}

secret_export="$(gpg --batch --export-secret-keys --armor "${fingerprints[@]}" 2>/dev/null)" || {
  echo "GPG secret-key export was cancelled or failed" >&2
  exit 1
}
[[ -n "$secret_export" ]] || {
  echo "GPG did not produce a secret-key export" >&2
  exit 1
}

secret_item_id="$(printf '%s\n' "$secret_export" |
  upsert_document "$SECRET_TITLE" "gpg-secret-keys.asc")"
unset secret_export

ownertrust_export="$(gpg --batch --export-ownertrust 2>/dev/null)" || {
  echo "GPG ownertrust export failed" >&2
  exit 1
}
ownertrust_item_id="$(printf '%s\n' "$ownertrust_export" |
  upsert_document "$OWNERTRUST_TITLE" "gpg-ownertrust.txt")"
unset ownertrust_export
[[ -n "$ownertrust_item_id" ]] || {
  echo "the 1Password ownertrust document was not created" >&2
  exit 1
}

if [[ -n "$VAULT" ]]; then
  downloaded_secret_command=(op document get "$secret_item_id" --vault "$VAULT")
else
  downloaded_secret_command=(op document get "$secret_item_id")
fi

downloaded_fingerprints="$({
  "${downloaded_secret_command[@]}" |
    gpg --batch --show-keys --with-colons 2>/dev/null |
    awk -F: '$1 == "fpr" { print toupper($10) }'
})"

for fingerprint in "${fingerprints[@]}"; do
  if ! grep -Fxq "$fingerprint" <<<"$downloaded_fingerprints"; then
    echo "the 1Password secret-key document could not be verified" >&2
    exit 1
  fi
done

echo "GPG secret keys and ownertrust were backed up and verified in 1Password."
