#!/bin/bash -p

set -euo pipefail
umask 077

SCRIPT_DIR="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(/usr/bin/dirname "$SCRIPT_DIR")"
# shellcheck source=scripts/trusted-path
source "$SCRIPT_DIR/trusted-path"
mac_setup_harden_environment
# shellcheck source=scripts/private-state-paths
source "$SCRIPT_DIR/private-state-paths"
# shellcheck source=scripts/trusted-1password
source "$SCRIPT_DIR/trusted-1password"

CONFIG_FILE="${FILEN_MENUBAR_CONFIG_FILE:-$HOME/Library/Application Support/filen-menubar/config.json}"
CONFIG_FILE="$(mac_setup_canonical_private_path \
  "$REPO_ROOT" "$CONFIG_FILE" "Filen Menubar config file")"
DOCUMENT_TITLE="${MAC_SETUP_FILEN_CONFIG_DOCUMENT:-Mac Setup Filen Menubar Config}"
VAULT="${MAC_SETUP_1PASSWORD_VAULT:-$MAC_SETUP_1PASSWORD_VAULT_DEFAULT}"
ONEPASSWORD_ACCOUNT_VALUE="${MAC_SETUP_1PASSWORD_ACCOUNT:-}"
CONFIG_DIR="$(/usr/bin/dirname "$CONFIG_FILE")"

mac_setup_sanitize_1password_environment
if [[ -n "$ONEPASSWORD_ACCOUNT_VALUE" ]]; then
  [[ "$ONEPASSWORD_ACCOUNT_VALUE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "unsafe 1Password account ID or shorthand" >&2
    exit 1
  }
  export OP_ACCOUNT="$ONEPASSWORD_ACCOUNT_VALUE"
fi
[[ "$VAULT" != *$'\n'* && "$VAULT" != *$'\r'* ]] || {
  echo "unsafe 1Password vault name" >&2
  exit 1
}

for command_name in op jq shasum awk; do
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "required command not found: $command_name" >&2
    exit 1
  }
done

op account get --format json >/dev/null 2>&1 || {
  echo "sign in to 1Password CLI before backing up the Filen Menubar config" >&2
  exit 1
}

[[ -d "$CONFIG_DIR" && ! -L "$CONFIG_DIR" && -O "$CONFIG_DIR" ]] || {
  echo "Filen Menubar config directory is unsafe or missing" >&2
  exit 1
}
[[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" && -O "$CONFIG_FILE" ]] || {
  echo "Filen Menubar config not found at its expected location" >&2
  exit 1
}
/bin/chmod 700 "$CONFIG_DIR"
/bin/chmod 600 "$CONFIG_FILE"

validate_config() {
  jq -e '
    type == "object"
    and (.localPath | type == "string" and length > 0)
    and (.remotePath | type == "string" and length > 0)
    and (.syncMode | IN("twoWay", "localToCloud", "cloudToLocal", "localBackup", "cloudBackup"))
    and (.autoStart | type == "boolean")
    and ((has("ignore") | not) or (.ignore | type == "array" and all(.[]; type == "string")))
    and ((has("excludeDotFiles") | not) or (.excludeDotFiles | type == "boolean"))
    and ((has("locale") | not) or (.locale | type == "string"))
    and ((has("loggingEnabled") | not) or (.loggingEnabled | type == "boolean"))
    and ((has("logLevel") | not) or (.logLevel | IN("trace", "debug", "info", "warn", "error")))
  ' "$1" >/dev/null
}

validate_config "$CONFIG_FILE" || {
  echo "Filen Menubar config is not valid for the pinned application version" >&2
  exit 1
}

if ! existing_id="$(
  mac_setup_find_unique_document_id "$DOCUMENT_TITLE" "$VAULT"
)"; then
  echo "could not safely resolve the existing Filen Menubar backup" >&2
  exit 1
fi

if [[ -n "$existing_id" ]]; then
  if [[ -n "$VAULT" ]]; then
    op document edit "$existing_id" "$CONFIG_FILE" --vault "$VAULT" \
      --file-name "filen-menubar-config.json" --tags "mac-setup,filen-menubar" \
      >/dev/null
  else
    op document edit "$existing_id" "$CONFIG_FILE" \
      --file-name "filen-menubar-config.json" --tags "mac-setup,filen-menubar" \
      >/dev/null
  fi
  item_id="$existing_id"
elif [[ -n "$VAULT" ]]; then
  item_id="$(op document create "$CONFIG_FILE" --vault "$VAULT" --title "$DOCUMENT_TITLE" \
    --file-name "filen-menubar-config.json" --tags "mac-setup,filen-menubar" \
    | jq -er '.id')"
else
  item_id="$(op document create "$CONFIG_FILE" --title "$DOCUMENT_TITLE" \
    --file-name "filen-menubar-config.json" --tags "mac-setup,filen-menubar" \
    | jq -er '.id')"
fi

[[ -n "$item_id" ]] || {
  echo "the 1Password Filen Menubar document was not created" >&2
  exit 1
}

local_hash="$(shasum -a 256 "$CONFIG_FILE" | awk '{print $1}')"
if [[ -n "$VAULT" ]]; then
  restored_hash="$(op document get "$item_id" --vault "$VAULT" | shasum -a 256 | awk '{print $1}')"
else
  restored_hash="$(op document get "$item_id" | shasum -a 256 | awk '{print $1}')"
fi

if [[ "$local_hash" != "$restored_hash" ]]; then
  echo "the 1Password Filen Menubar document could not be verified" >&2
  exit 1
fi

echo "Filen Menubar config was backed up and verified in 1Password."
