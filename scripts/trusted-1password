#!/bin/bash -p

# Private restore commands must not inherit an alternate 1Password backend,
# service-account token, session, default vault, or config directory. Callers
# capture the explicit MAC_SETUP_1PASSWORD_* values before invoking this.
mac_setup_sanitize_1password_environment() {
  local variable_name

  while IFS= read -r variable_name; do
    [[ "$variable_name" =~ ^OP_[A-Za-z0-9_]+$ ]] || continue
    builtin unset "$variable_name"
  done < <(builtin compgen -A variable OP_ || true)
}

# Resolve an existing Document by exact title without treating an operational
# failure as "not found." Listing also lets us reject ambiguous duplicate
# titles before an upsert creates or edits the wrong recovery artifact.
mac_setup_find_unique_document_id() {
  local document_title="$1"
  local vault="${2:-}"
  local documents_json
  local item_id

  [[ -n "$document_title" && \
    "$document_title" != *$'\n'* && "$document_title" != *$'\r'* ]] || {
    echo "unsafe or empty 1Password document title" >&2
    return 1
  }

  if [[ -n "$vault" ]]; then
    if ! documents_json="$(
      op item list --categories Document --vault "$vault" --format json
    )"; then
      echo "could not list 1Password Documents in the selected vault" >&2
      return 1
    fi
  elif ! documents_json="$(
    op item list --categories Document --format json
  )"; then
    echo "could not list 1Password Documents" >&2
    return 1
  fi

  if ! item_id="$(
    jq -er --arg title "$document_title" '
      if type != "array" then
        error("expected a JSON array")
      else
        [ .[] | select(type == "object" and .title? == $title) ]
        | if length == 0 then
            ""
          elif length == 1
            and (.[0].id? | type == "string" and length > 0) then
            .[0].id
          elif length == 1 then
            error("matching Document has no valid ID")
          else
            error("multiple Documents have the requested title")
          end
      end
    ' <<<"$documents_json"
  )"; then
    echo "could not resolve a unique 1Password Document" >&2
    return 1
  fi

  builtin printf '%s' "$item_id"
}
