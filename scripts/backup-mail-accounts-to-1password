#!/bin/bash -p

set -euo pipefail
umask 077

REPO_ROOT="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=scripts/trusted-path
source "$REPO_ROOT/scripts/trusted-path"
mac_setup_harden_environment
# shellcheck source=scripts/private-state-paths
source "$REPO_ROOT/scripts/private-state-paths"
# shellcheck source=scripts/trusted-1password
source "$REPO_ROOT/scripts/trusted-1password"
CONFIG_FILE="${MAC_SETUP_MAIL_CONFIG_FILE:-$MAC_SETUP_MAIL_CONFIG_FILE_DEFAULT}"
CONFIG_FILE="$(mac_setup_canonical_private_path \
  "$REPO_ROOT" "$CONFIG_FILE" "Mail account config")"
DOCUMENT_TITLE="${MAC_SETUP_MAIL_CONFIG_DOCUMENT:-Mac Setup Mail Accounts}"
VAULT="${MAC_SETUP_1PASSWORD_VAULT:-$MAC_SETUP_1PASSWORD_VAULT_DEFAULT}"
ONEPASSWORD_ACCOUNT_VALUE="${MAC_SETUP_1PASSWORD_ACCOUNT:-}"

mac_setup_sanitize_1password_environment
if [[ -n "$ONEPASSWORD_ACCOUNT_VALUE" ]]; then
  [[ "$ONEPASSWORD_ACCOUNT_VALUE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "unsafe 1Password account ID or shorthand" >&2
    exit 1
  }
  export OP_ACCOUNT="$ONEPASSWORD_ACCOUNT_VALUE"
fi
[[ "$VAULT" != *$'\n'* && "$VAULT" != *$'\r'* ]] || {
  echo "unsafe 1Password vault name" >&2
  exit 1
}

for command_name in op jq shasum awk; do
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "required command not found: $command_name" >&2
    exit 1
  }
done

op account get --format json >/dev/null 2>&1 || {
  echo "sign in to 1Password CLI before backing up Mail account metadata" >&2
  exit 1
}

"$REPO_ROOT/scripts/validate-mail-accounts-config" "$CONFIG_FILE" >/dev/null

if ! existing_id="$(
  mac_setup_find_unique_document_id "$DOCUMENT_TITLE" "$VAULT"
)"; then
  echo "could not safely resolve the existing Mail account backup" >&2
  exit 1
fi

if [[ -n "$existing_id" ]]; then
  if [[ -n "$VAULT" ]]; then
    op document edit "$existing_id" "$CONFIG_FILE" --vault "$VAULT" \
      --file-name "mail-accounts.json" --tags "mac-setup,mail-accounts" >/dev/null
  else
    op document edit "$existing_id" "$CONFIG_FILE" \
      --file-name "mail-accounts.json" --tags "mac-setup,mail-accounts" >/dev/null
  fi
  item_id="$existing_id"
elif [[ -n "$VAULT" ]]; then
  item_id="$(op document create "$CONFIG_FILE" --vault "$VAULT" --title "$DOCUMENT_TITLE" \
    --file-name "mail-accounts.json" --tags "mac-setup,mail-accounts" |
    jq -er '.id')"
else
  item_id="$(op document create "$CONFIG_FILE" --title "$DOCUMENT_TITLE" \
    --file-name "mail-accounts.json" --tags "mac-setup,mail-accounts" |
    jq -er '.id')"
fi

[[ -n "$item_id" ]] || {
  echo "the 1Password Mail account document was not created" >&2
  exit 1
}

local_hash="$(shasum -a 256 "$CONFIG_FILE" | awk '{print $1}')"
if [[ -n "$VAULT" ]]; then
  restored_hash="$(op document get "$item_id" --vault "$VAULT" |
    shasum -a 256 | awk '{print $1}')"
else
  restored_hash="$(op document get "$item_id" |
    shasum -a 256 | awk '{print $1}')"
fi

if [[ "$local_hash" != "$restored_hash" ]]; then
  echo "the 1Password Mail account document could not be verified" >&2
  exit 1
fi

echo "Password-free Mail/DAV account metadata was backed up and verified in 1Password."
