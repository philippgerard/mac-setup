#!/bin/bash -p

set -euo pipefail
umask 077

REPO_ROOT="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=scripts/trusted-path
source "$REPO_ROOT/scripts/trusted-path"
mac_setup_harden_environment
# shellcheck source=scripts/trusted-1password
source "$REPO_ROOT/scripts/trusted-1password"

test_root="$(/usr/bin/mktemp -d /tmp/mac-setup-op-lookup-test.XXXXXX)"
cleanup() {
  if [[ -n "${test_root:-}" && -d "$test_root" && ! -L "$test_root" && \
    -O "$test_root" && "$test_root" == /tmp/mac-setup-op-lookup-test.* ]]; then
    /bin/rm -rf -- "$test_root" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

mock_bin="$test_root/bin"
/bin/mkdir -m 700 "$mock_bin"

mock_op="$mock_bin/op"
# The single-quoted expressions below are source for the mock, not expressions
# that should expand while this test constructs it.
# shellcheck disable=SC2016
builtin printf '%s\n' \
  '#!/bin/bash -p' \
  'set -euo pipefail' \
  'builtin printf "%s\n" "$*" >"$MAC_SETUP_TEST_OP_LOG"' \
  'case "$MAC_SETUP_TEST_OP_MODE" in' \
  '  absent)' \
  "    builtin printf '%s\\n' '[]'" \
  '    ;;' \
  '  unique)' \
  "    builtin printf '%s\\n' '[{\"id\":\"document-id\",\"title\":\"Expected Document\",\"category\":\"DOCUMENT\"}]'" \
  '    ;;' \
  '  duplicate)' \
  "    builtin printf '%s\\n' '[{\"id\":\"first-id\",\"title\":\"Expected Document\"},{\"id\":\"second-id\",\"title\":\"Expected Document\"}]'" \
  '    ;;' \
  '  malformed)' \
  "    builtin printf '%s\\n' '{\"id\":\"not-an-array\"}'" \
  '    ;;' \
  '  failure)' \
  '    exit 23' \
  '    ;;' \
  '  *)' \
  '    exit 24' \
  '    ;;' \
  'esac' \
  >"$mock_op"
/bin/chmod 700 "$mock_op"

export PATH="$mock_bin:$PATH"
export MAC_SETUP_TEST_OP_LOG="$test_root/op.log"

MAC_SETUP_TEST_OP_MODE=absent
export MAC_SETUP_TEST_OP_MODE
[[ -z "$(mac_setup_find_unique_document_id "Expected Document" "")" ]]

MAC_SETUP_TEST_OP_MODE=unique
export MAC_SETUP_TEST_OP_MODE
[[ "$(mac_setup_find_unique_document_id "Expected Document" "")" == \
  "document-id" ]]
[[ "$(/bin/cat "$MAC_SETUP_TEST_OP_LOG")" == \
  "item list --categories Document --format json" ]]

[[ "$(mac_setup_find_unique_document_id \
  "Expected Document" "Recovery Vault")" == "document-id" ]]
[[ "$(/bin/cat "$MAC_SETUP_TEST_OP_LOG")" == \
  "item list --categories Document --vault Recovery Vault --format json" ]]

for failure_mode in duplicate malformed failure; do
  MAC_SETUP_TEST_OP_MODE="$failure_mode"
  export MAC_SETUP_TEST_OP_MODE
  if mac_setup_find_unique_document_id "Expected Document" "" \
    >/dev/null 2>&1; then
    echo "1Password lookup unexpectedly accepted $failure_mode output" >&2
    exit 1
  fi
done

if mac_setup_find_unique_document_id $'unsafe\ntitle' "" \
  >/dev/null 2>&1; then
  echo "1Password lookup accepted an unsafe title" >&2
  exit 1
fi

for backup_script in \
  backup-filen-menubar-to-1password \
  backup-gpg-to-1password \
  backup-mail-accounts-to-1password; do
  /usr/bin/grep -Fq 'mac_setup_find_unique_document_id' \
    "$REPO_ROOT/scripts/$backup_script" || {
      echo "$backup_script does not use the fail-closed Document lookup" >&2
      exit 1
    }
  if /usr/bin/grep -Fq 'op item get' "$REPO_ROOT/scripts/$backup_script"; then
    echo "$backup_script still performs an ambiguous title lookup" >&2
    exit 1
  fi
done

echo "1Password Document lookup tests passed"
