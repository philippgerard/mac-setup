#!/bin/bash -p

set -euo pipefail
umask 077

REPO_ROOT="$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=scripts/trusted-path
source "$REPO_ROOT/scripts/trusted-path"
mac_setup_harden_environment
# shellcheck source=scripts/private-state-paths
source "$REPO_ROOT/scripts/private-state-paths"
# shellcheck source=scripts/trusted-1password
source "$REPO_ROOT/scripts/trusted-1password"
DOCUMENT_TITLE="${MAC_SETUP_MAIL_CONFIG_DOCUMENT:-Mac Setup Mail Accounts}"
VAULT="${MAC_SETUP_1PASSWORD_VAULT:-}"
ONEPASSWORD_ACCOUNT_VALUE="${MAC_SETUP_1PASSWORD_ACCOUNT:-}"
CONFIG_FILE="${MAC_SETUP_MAIL_CONFIG_FILE:-$MAC_SETUP_MAIL_CONFIG_FILE_DEFAULT}"
PROFILE_DIR="${MAC_SETUP_MAIL_PROFILE_DIR:-$MAC_SETUP_MAIL_PROFILE_DIR_DEFAULT}"
CONFIG_FILE="$(mac_setup_canonical_private_path \
  "$REPO_ROOT" "$CONFIG_FILE" "Mail account config")"
PROFILE_DIR="$(mac_setup_canonical_private_path \
  "$REPO_ROOT" "$PROFILE_DIR" "Mail profile directory")"
OPEN_PROFILE_DIR=1

mac_setup_sanitize_1password_environment
if [[ -n "$ONEPASSWORD_ACCOUNT_VALUE" ]]; then
  [[ "$ONEPASSWORD_ACCOUNT_VALUE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "unsafe 1Password account ID or shorthand" >&2
    exit 1
  }
  export OP_ACCOUNT="$ONEPASSWORD_ACCOUNT_VALUE"
fi
[[ "$VAULT" != *$'\n'* && "$VAULT" != *$'\r'* ]] || {
  echo "unsafe 1Password vault name" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: restore-mail-accounts-from-1password [--no-open]

Restore private, password-free Mail/DAV account metadata from 1Password.
Generate optional macOS profiles for IMAP/DAV accounts; Microsoft Exchange
accounts use the native Internet Accounts OAuth flow. By default, open the
profile directory when it contains a generated profile.

Options:
  --no-open  Generate the profiles without opening their directory.
  -h, --help Show this help.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-open)
      OPEN_PROFILE_DIR=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

for command_name in find jq mktemp op; do
  command -v "$command_name" >/dev/null 2>&1 || {
    echo "required command not found: $command_name" >&2
    exit 1
  }
done

op account get --format json >/dev/null 2>&1 || {
  echo "sign in to 1Password CLI before restoring Mail account metadata" >&2
  exit 1
}

config_dir="$(/usr/bin/dirname "$CONFIG_FILE")"
if [[ -e "$config_dir" || -L "$config_dir" ]]; then
  [[ -d "$config_dir" && ! -L "$config_dir" && -O "$config_dir" ]] || {
    echo "Mail account config directory is unsafe" >&2
    exit 1
  }
  [[ "$(/usr/bin/stat -f '%Lp' "$config_dir")" == "700" ]] || {
    echo "Mail account config directory must have mode 0700" >&2
    exit 1
  }
else
  config_parent="$(/usr/bin/dirname "$config_dir")"
  [[ -d "$config_parent" && ! -L "$config_parent" && -O "$config_parent" ]] || {
    echo "Mail account config parent directory is unsafe or missing" >&2
    exit 1
  }
  /bin/mkdir -m 700 -- "$config_dir"
fi
if [[ -e "$CONFIG_FILE" || -L "$CONFIG_FILE" ]]; then
  [[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" && -O "$CONFIG_FILE" ]] || {
    echo "existing Mail account config is unsafe" >&2
    exit 1
  }
  [[ "$(/usr/bin/stat -f '%Lp' "$CONFIG_FILE")" == "600" ]] || {
    echo "existing Mail account config must have mode 0600" >&2
    exit 1
  }
fi
config_tmp="$(mktemp "$config_dir/.mail-accounts.XXXXXX")"
config_backup=""
cleanup() {
  if [[ -n "${config_tmp:-}" ]]; then
    /bin/rm -f -- "$config_tmp" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

if [[ -n "$VAULT" ]]; then
  op document get "$DOCUMENT_TITLE" --vault "$VAULT" >"$config_tmp"
else
  op document get "$DOCUMENT_TITLE" >"$config_tmp"
fi

"$REPO_ROOT/scripts/validate-mail-accounts-config" "$config_tmp" >/dev/null || {
  echo "the 1Password document is not valid password-free Mail account metadata" >&2
  exit 1
}
chmod 600 "$config_tmp"

if [[ -f "$CONFIG_FILE" ]] && ! cmp -s "$CONFIG_FILE" "$config_tmp"; then
  config_backup="$(mktemp "${CONFIG_FILE}.pre-restore-$(date -u '+%Y%m%dT%H%M%SZ').XXXXXX")"
  install -m 600 "$CONFIG_FILE" "$config_backup"
fi

mv "$config_tmp" "$CONFIG_FILE"
config_tmp=""
trap - EXIT

"$REPO_ROOT/scripts/generate-mail-account-profiles" "$CONFIG_FILE" "$PROFILE_DIR"

generated_profile="$(find "$PROFILE_DIR" -maxdepth 1 -type f \
  -name '*.mobileconfig' -print -quit)"
if [[ "$OPEN_PROFILE_DIR" -eq 1 && -n "$generated_profile" ]]; then
  /usr/bin/open "$PROFILE_DIR"
fi

echo "Mail/DAV account metadata was restored and password-free IMAP/DAV profiles were generated."
if [[ -n "$config_backup" ]]; then
  echo "The different previous metadata was preserved beside it with a pre-restore timestamp."
fi
if [[ "$OPEN_PROFILE_DIR" -eq 1 && -n "$generated_profile" ]]; then
  echo "Open only the generated IMAP/DAV profiles wanted on this Mac, then review them in System Settings > General > Device Management."
elif [[ "$OPEN_PROFILE_DIR" -eq 1 ]]; then
  echo "No IMAP/DAV profiles were generated; selected Exchange accounts use native Internet Accounts setup."
else
  echo "Open only the desired IMAP/DAV files from the generated profile directory when ready."
fi
echo "Enter email and DAV app passwords when prompted."
echo "Each IMAP/DAV profile can be installed or removed independently; removing one also removes every managed service in that profile."
echo "Configure selected Microsoft Exchange accounts through Internet Accounts only after native hardware-key readiness has been checked."
